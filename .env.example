# Copy to .env.local and fill in. .env.local is git-ignored — never commit a real key.
# Every value below is optional: with an empty file the app runs fully, using the
# built-in rules engine and the in-memory store.

# ---------------------------------------------------------------- AI (optional)
# The model only rewords what the deterministic engine already decided. With no key
# the app runs in offline rules mode and says so in a banner on every page.
# Set ONE provider. Gemini is checked first.
# AI_OFFLINE=true forces the rules engine even when a key is present. The e2e suite sets
# it so the assertions test the engine's ranking rather than a model's phrasing.
AI_OFFLINE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Override only to point at a proxy. Default: https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Per-call budget. A slow model falls back to the rules rather than blocking the page.
AI_TIMEOUT_MS=12000

# ---------------------------------------------------------- storage (optional)
# Unset: an in-process store that is wiped on restart. Fine for the demo.
# Set: postgres connection string, schema in lib/db/schema.sql via `npm run db:push`.
DATABASE_URL=

# -------------------------------------------------------------------- the rest
APP_BASE_URL=http://localhost:3000
# Requests per minute per client address. 0 disables the limit.
RATE_LIMIT_PER_MIN=30
# Tighter budget for the routes that can reach the model.
MODEL_RATE_LIMIT_PER_MIN=6
# true hides /start and serves the three seeded demo cases only.
DEMO_MODE_ONLY=false
# 0..1 — makes the mock government endpoints fail at this rate, to exercise error paths.
MOCK_FAILURE_RATE=0
LOG_LEVEL=info
